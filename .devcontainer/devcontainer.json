{
  "name": "ALASKA2",
  "dockerComposeFile": ["../compose.yml", "../.local/compose.lab.yml"],
  "service": "lab",
  "workspaceFolder": "/workspace",
  "initializeCommand": ["python3", "-m", "tools.lab", "prepare"],
  "overrideCommand": false,
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {"python.defaultInterpreterPath": "/opt/venv/bin/python"}
    }
  }
}
